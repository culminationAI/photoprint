#!/bin/bash
# Ярлык «Печать картинок» (спецификация § 4.7).
#
# Установщик кладёт этот файл в папку для картинок под именем
# `Печать картинок.command` (I7). Заказчик открывает его двойным щелчком, и
# Терминал выполняет его в своём окне. Ярлык запускает клиент для той
# папки, в которой он лежит сейчас, поэтому папку можно переносить куда
# угодно.
#
# Аргументов нет. Окружение: `HOME` — где искать клиент (`~/.photoprint`);
# переменные `PHOTOPRINT_*` доходят до `python -m photoprint` как есть
# (§ 4.5).
#
# Правила спецификации, которые держит ярлык:
# - L1 — папка — каталог, где лежит сам ярлык;
# - L2 — клиента нет → «Клиент не установлен…», код 1;
# - L3 — `exec python -m photoprint --folder <папка ярлыка>` из
#   `~/.photoprint/app`.
#
# `#!/bin/bash` — на маке это bash 3.2: только его конструкции.
set -euo pipefail

# L1: каталог ярлыка — по его собственному пути, без символических ссылок.
# Кавычки и `--` держат пробелы, кириллицу и имена с «-» в начале; вывод
# `cd` заглушён, потому что при заданном `CDPATH` он печатает каталог и
# испортил бы `HERE`.
HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"
# L2: Корень клиента (§ 3.3).
R="$HOME/.photoprint"
# L2: без окружения Python или без кода клиента запускать нечего. `-x`
# ложно и для висячей ссылки — так выглядит окружение после переустановки
# Command Line Tools; повторная установка его чинит (I5).
if [ ! -x "$R/venv/bin/python" ] || [ ! -f "$R/app/photoprint/__init__.py" ]; then
  echo "Клиент не установлен. Выполните команду установки из README."
  exit 1
fi
# L3: из каталога кода — там `-m photoprint` находит пакет.
cd "$R/app"
# L3: `exec` — Python занимает место bash, и сигналы (закрытие окна, Ctrl+C)
# идут прямо в него, без промежуточного процесса (M7).
exec "$R/venv/bin/python" -m photoprint --folder "$HERE"
